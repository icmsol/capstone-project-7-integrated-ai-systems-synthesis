{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://icmsol.example/project7/schemas/common_definitions.schema.json",
  "title": "Project 7 Common Definitions",
  "description": "Reusable definitions shared across Project 7 data contracts.",
  "type": "object",
  "$defs": {
    "semantic_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "examples": [
        "1.0.0"
      ]
    },
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "uri_or_path": {
      "type": "string",
      "minLength": 1
    },
    "utc_datetime": {
      "type": "string",
      "format": "date-time"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "bounded_confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    },
    "nonempty_string": {
      "type": "string",
      "minLength": 1
    },
    "reason_code": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_:-]{2,63}$"
    },
    "source_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "source_type",
        "source_location",
        "retrieved_at",
        "sha256",
        "approved_for_use"
      ],
      "properties": {
        "source_id": {
          "$ref": "#/$defs/identifier"
        },
        "source_type": {
          "type": "string",
          "enum": [
            "public_web",
            "public_file",
            "frozen_snapshot",
            "synthetic",
            "deidentified",
            "authorized_internal",
            "model_package",
            "configuration"
          ]
        },
        "source_location": {
          "$ref": "#/$defs/uri_or_path"
        },
        "retrieved_at": {
          "$ref": "#/$defs/utc_datetime"
        },
        "snapshot_date": {
          "oneOf": [
            {
              "$ref": "#/$defs/date"
            },
            {
              "type": "null"
            }
          ]
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "approved_for_use": {
          "type": "boolean"
        },
        "approval_basis": {
          "type": [
            "string",
            "null"
          ]
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "limitation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "description",
        "material"
      ],
      "properties": {
        "code": {
          "$ref": "#/$defs/reason_code"
        },
        "description": {
          "$ref": "#/$defs/nonempty_string"
        },
        "material": {
          "type": "boolean"
        },
        "mitigation": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "human_role": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role_id",
        "role_name"
      ],
      "properties": {
        "role_id": {
          "$ref": "#/$defs/identifier"
        },
        "role_name": {
          "$ref": "#/$defs/nonempty_string"
        },
        "organization_id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}