{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://icmsol.example/project7/schemas/expected_case_outcome.schema.json",
  "title": "Project 7 Frozen Scenario Expected Outcome v1.0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "expected_outcome_schema_version",
    "case_id",
    "expected_terminal_outcome",
    "expected_case_status",
    "expected_primary_stage_id",
    "expected_primary_stage",
    "expected_component",
    "expected_recommendation_code",
    "expected_recommendation_label",
    "expected_reason_codes",
    "expected_human_route",
    "expected_audit_events",
    "required_evidence_classes",
    "must_occur",
    "must_not_occur",
    "acceptance_target_ids",
    "safeguard_control_ids",
    "assertions",
    "result_status"
  ],
  "properties": {
    "expected_outcome_schema_version": {
      "type": "string",
      "const": "1.0.1"
    },
    "case_id": {
      "$ref": "common_definitions.schema.json#/$defs/identifier"
    },
    "expected_terminal_outcome": {
      "type": "string",
      "enum": [
        "finalized_accept",
        "finalized_accept_with_conditions",
        "finalized_reject",
        "deferred",
        "escalated",
        "failed_closed"
      ]
    },
    "expected_case_status": {
      "type": "string",
      "enum": [
        "finalized",
        "deferred",
        "escalated",
        "failed_closed"
      ]
    },
    "expected_primary_stage_id": {
      "type": "string",
      "pattern": "^STG-\\d{2}$"
    },
    "expected_primary_stage": {
      "type": "string",
      "minLength": 3
    },
    "expected_component": {
      "type": "string",
      "minLength": 3
    },
    "expected_recommendation_code": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "R-01",
        "R-02",
        "R-03",
        "R-04",
        "R-05",
        "R-06",
        null
      ]
    },
    "expected_recommendation_label": {
      "type": [
        "string",
        "null"
      ]
    },
    "expected_reason_codes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "common_definitions.schema.json#/$defs/reason_code"
      }
    },
    "expected_human_route": {
      "type": [
        "string",
        "null"
      ]
    },
    "expected_audit_events": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "required_evidence_classes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "must_occur": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 10
      }
    },
    "must_not_occur": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string",
        "minLength": 10
      }
    },
    "acceptance_target_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^AT-\\d{2}$"
      }
    },
    "safeguard_control_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^SG-\\d{3}$"
      }
    },
    "assertions": {
      "type": "array",
      "minItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "assertion_id",
          "assertion_type",
          "target_path",
          "expected_value",
          "severity"
        ],
        "properties": {
          "assertion_id": {
            "$ref": "common_definitions.schema.json#/$defs/identifier"
          },
          "assertion_type": {
            "type": "string",
            "enum": [
              "equals",
              "contains_all",
              "contains_none",
              "schema_valid",
              "checksum_valid",
              "max_count",
              "separate_artifact"
            ]
          },
          "target_path": {
            "type": "string",
            "minLength": 3
          },
          "expected_value": {},
          "severity": {
            "type": "string",
            "enum": [
              "critical",
              "major",
              "minor"
            ]
          }
        }
      }
    },
    "result_status": {
      "type": "string",
      "const": "not_executed_target_only"
    }
  }
}
