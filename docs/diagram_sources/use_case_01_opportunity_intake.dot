
digraph UseCase {

graph [
  bgcolor="white",
  fontname="Helvetica",
  fontsize=11,
  pad=0.25,
  nodesep=0.45,
  ranksep=0.65,
  splines=ortho
];
node [
  fontname="Helvetica",
  fontsize=10,
  style="rounded,filled",
  penwidth=1.2,
  color="#375A7F",
  fillcolor="#F7FAFC",
  margin="0.12,0.08"
];
edge [
  fontname="Helvetica",
  fontsize=9,
  color="#4A5568",
  penwidth=1.2,
  arrowsize=0.8
];

rankdir=LR;

analyst [shape=box, label="«actor»\nOpportunity Analyst", fillcolor="#EAF2F8"];
source [shape=box, label="«actor»\nPublic Procurement Source", fillcolor="#EAF2F8"];
data_owner [shape=box, label="«actor»\nData / Privacy Reviewer", fillcolor="#EAF2F8"];

subgraph cluster_system {
  label="Major Function 1 — Opportunity Intake and Provenance";
  color="#1F4E78";
  penwidth=1.6;
  style="rounded";
  uc1 [shape=ellipse, label="Create Case", fillcolor="#F7FAFC"];
uc2 [shape=ellipse, label="Validate Required Fields", fillcolor="#F7FAFC"];
uc3 [shape=ellipse, label="Normalize Opportunity Record", fillcolor="#F7FAFC"];
uc4 [shape=ellipse, label="Record Source and Checksum", fillcolor="#F7FAFC"];
uc5 [shape=ellipse, label="Recommend Accept, Return,\nor Reject Intake", fillcolor="#F7FAFC"];
uc6 [shape=ellipse, label="Escalate Sensitive or\nUnverified Data", fillcolor="#F7FAFC"];
}

analyst -> uc1 [label=""];
source -> uc1 [label=""];
uc1 -> uc2 [style=dashed, label="«include»"];
uc2 -> uc3 [style=dashed, label="«include»"];
uc3 -> uc4 [style=dashed, label="«include»"];
uc4 -> uc5 [style=dashed, label="«include»"];
uc2 -> uc6 [style=dashed, label="«extend»"];
data_owner -> uc6 [label=""];
}
