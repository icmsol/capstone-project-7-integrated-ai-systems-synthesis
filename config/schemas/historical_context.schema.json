{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://icmsol.example/project7/schemas/historical_context.schema.json",
  "title": "Descriptive Historical Procurement Context",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "context_schema_version",
    "case_id",
    "source_period",
    "source_records",
    "matched_historical_records",
    "service_category_counts",
    "staffing_family_counts",
    "interpretation",
    "limitations"
  ],
  "properties": {
    "context_schema_version": {
      "$ref": "common_definitions.schema.json#/$defs/semantic_version"
    },
    "case_id": {
      "$ref": "common_definitions.schema.json#/$defs/identifier"
    },
    "source_period": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start_date",
        "end_date"
      ],
      "properties": {
        "start_date": {
          "$ref": "common_definitions.schema.json#/$defs/date"
        },
        "end_date": {
          "$ref": "common_definitions.schema.json#/$defs/date"
        }
      }
    },
    "source_records": {
      "type": "integer",
      "minimum": 0
    },
    "matched_historical_records": {
      "type": "integer",
      "minimum": 0
    },
    "service_category_counts": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "staffing_family_counts": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "source_asset_checksums": {
      "type": "object",
      "additionalProperties": {
        "$ref": "common_definitions.schema.json#/$defs/sha256"
      }
    },
    "interpretation": {
      "type": "string",
      "minLength": 1
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "common_definitions.schema.json#/$defs/limitation"
      }
    }
  }
}