{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/project7/organization_profile.schema.json",
  "title": "Project 7 Organization Profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "organization_id",
    "organization_name",
    "display_name",
    "profile_version",
    "effective_date",
    "fictional",
    "description",
    "website",
    "target_sectors",
    "target_geographies",
    "service_catalog_file",
    "opportunity_rules_file",
    "staffing_map_file",
    "reviewer_roles_file",
    "recommendation_thresholds_file",
    "fixed_safeguards_file",
    "profile_owner_role",
    "review_cycle_days"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "organization_id": {
      "type": "string",
      "pattern": "^[A-Z0-9_-]{3,30}$"
    },
    "organization_name": {
      "type": "string",
      "minLength": 2
    },
    "display_name": {
      "type": "string",
      "minLength": 2
    },
    "profile_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "effective_date": {
      "type": "string",
      "format": "date"
    },
    "fictional": {
      "type": "boolean"
    },
    "description": {
      "type": "string",
      "minLength": 20
    },
    "website": {
      "type": "string",
      "format": "uri"
    },
    "target_sectors": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 2
      }
    },
    "target_geographies": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 2
      }
    },
    "business_designations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "designation",
          "status",
          "verification_required_before_external_use"
        ],
        "properties": {
          "designation": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "verification_required_before_external_use": {
            "type": "boolean"
          }
        }
      }
    },
    "service_catalog_file": {
      "type": "string",
      "pattern": "\\.csv$"
    },
    "opportunity_rules_file": {
      "type": "string",
      "pattern": "\\.json$"
    },
    "staffing_map_file": {
      "type": "string",
      "pattern": "\\.csv$"
    },
    "reviewer_roles_file": {
      "type": "string",
      "pattern": "\\.json$"
    },
    "recommendation_thresholds_file": {
      "type": "string",
      "pattern": "\\.json$"
    },
    "fixed_safeguards_file": {
      "type": "string",
      "pattern": "\\.json$"
    },
    "source_urls": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "format": "uri"
      }
    },
    "profile_owner_role": {
      "type": "string",
      "minLength": 3
    },
    "review_cycle_days": {
      "type": "integer",
      "minimum": 1,
      "maximum": 365
    },
    "notes": {
      "type": "string"
    }
  }
}