{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://icmsol.example/project7/schemas/service_alignment.schema.json",
  "title": "Organization Service Alignment Assessment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "alignment_schema_version",
    "case_id",
    "organization_id",
    "profile_version",
    "service_catalog_version",
    "matched_capabilities",
    "excluded_matches",
    "alignment_score",
    "alignment_label",
    "reason_codes",
    "limitations"
  ],
  "properties": {
    "alignment_schema_version": {
      "$ref": "common_definitions.schema.json#/$defs/semantic_version"
    },
    "case_id": {
      "$ref": "common_definitions.schema.json#/$defs/identifier"
    },
    "organization_id": {
      "$ref": "common_definitions.schema.json#/$defs/identifier"
    },
    "profile_version": {
      "$ref": "common_definitions.schema.json#/$defs/semantic_version"
    },
    "service_catalog_version": {
      "$ref": "common_definitions.schema.json#/$defs/semantic_version"
    },
    "matched_capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "capability_id",
          "capability_name",
          "service_family_id",
          "matched_terms",
          "match_strength"
        ],
        "properties": {
          "capability_id": {
            "$ref": "common_definitions.schema.json#/$defs/identifier"
          },
          "capability_name": {
            "type": "string",
            "minLength": 1
          },
          "service_family_id": {
            "$ref": "common_definitions.schema.json#/$defs/identifier"
          },
          "matched_terms": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "match_strength": {
            "type": "string",
            "enum": [
              "strong",
              "moderate",
              "weak"
            ]
          },
          "evidence_text": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "excluded_matches": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "term",
          "reason"
        ],
        "properties": {
          "term": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "alignment_score": {
      "$ref": "common_definitions.schema.json#/$defs/bounded_confidence"
    },
    "alignment_label": {
      "type": "string",
      "enum": [
        "strong_alignment",
        "conditional_alignment",
        "weak_alignment",
        "no_alignment",
        "insufficient_information"
      ]
    },
    "staffing_families": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "reason_codes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "common_definitions.schema.json#/$defs/reason_code"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "$ref": "common_definitions.schema.json#/$defs/limitation"
      }
    }
  }
}