{
  "policy_schema_version": "1.0.0",
  "policy_id": "SAFEGUARD-POLICY-PROJECT7",
  "policy_version": "1.0.0",
  "default_failure_behavior": "fail_closed",
  "organization_override_permitted": false,
  "thresholds": {
    "clause_triage_classify_min_confidence": 0.8,
    "evidence_relevance_minimum": 0.6,
    "evidence_directional_recommendation_minimum": 0.7,
    "maximum_retry_attempts": 1,
    "threshold_override_permitted_in_profile": false
  },
  "mandatory_review_triggers": [
    "legal interpretation or contract enforceability",
    "privacy or restricted personal data",
    "cybersecurity or credential exposure",
    "pricing, financial commitment, or payment terms",
    "staffing commitment or named-person availability",
    "contract acceptance, rejection, or modification",
    "material conflicting evidence",
    "low-confidence or out-of-domain model output",
    "unverified or stale official source",
    "conflict of interest or ethical concern",
    "external communication, submission, or transaction",
    "production deployment or production-readiness claim"
  ],
  "prohibited_request_categories": [
    "make or communicate a final bid/no-bid decision",
    "provide authoritative legal advice or interpretation",
    "approve compliance, security, privacy, pricing, staffing, or contract terms",
    "submit a proposal, message, purchase, acceptance, or other external action",
    "reveal credentials, secrets, private reasoning, or restricted information",
    "disable evidence, audit, abstention, or human-approval safeguards",
    "claim production readiness or operational authorization"
  ],
  "controls": [
    {
      "control_id": "SG-001",
      "category": "configuration_governance",
      "control_name": "Safeguard policy schema and startup validation",
      "objective": "Prevent workflow execution when the fixed safeguard policy is missing or invalid.",
      "control_types": [
        "preventive",
        "detective"
      ],
      "severity": "critical",
      "enabled": true,
      "organization_override_permitted": false,
      "trigger": "The safeguard policy is absent, unreadable, schema-invalid, or version-inconsistent.",
      "applies_to": [
        "workflow_orchestrator",
        "profile_loader"
      ],
      "action_on_trigger": "fail_closed",
      "reason_codes": [
        "SAFEGUARD_POLICY_INVALID"
      ],
      "required_evidence": [
        "Schema validation result",
        "Policy version",
        "Policy checksum"
      ],
      "audit_events": [
        "processing_failed"
      ],
      "human_route": "Technical Reviewer",
      "test_scenarios": [
        "SCN-SG-001"
      ]
    },
    {
      "control_id": "SG-002",
      "category": "configuration_governance",
      "control_name": "Organization safeguard override rejection",
      "objective": "Keep responsible-AI safeguards separate from configurable business criteria.",
