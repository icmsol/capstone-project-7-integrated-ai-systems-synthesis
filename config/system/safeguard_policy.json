        "Configuration source",
        "Resolution precedence"
      ],
      "audit_events": [
        "configuration_loaded",
        "processing_failed"
      ],
      "human_route": "Executive Authority",
      "test_scenarios": [
        "SCN-SG-002"
      ]
    },
