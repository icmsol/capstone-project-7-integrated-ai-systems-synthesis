{
  "contract_schema_version": "1.0.0",
  "contract_id": "CONTRACT-RECOMMENDATION",
  "component_id": "recommendation_engine",
  "component_name": "Evidence-Linked Nonbinding Recommendation Engine",
  "component_type": "recommendation_engine",
  "purpose": "Combine validated alignment, historical context, evidence, routing, counterevidence, gaps, and conditions into a complete nonbinding recommendation.",
  "implementation_boundary": "hybrid",
  "inputs": [
    {
      "name": "service_alignment",
      "schema_ref": "service_alignment.schema.json",
      "required": false,
      "cardinality": "zero_or_one",
      "source": "service_alignment_engine",
      "description": null
    },
    {
      "name": "historical_context",
      "schema_ref": "historical_context.schema.json",
      "required": false,
      "cardinality": "zero_or_one",
      "source": "historical_context_provider",
      "description": null
    },
    {
      "name": "validated_evidence",
      "schema_ref": "evidence_item.schema.json",
      "required": false,
      "cardinality": "zero_or_more",
      "source": "evidence_validator",
      "description": null
    },
    {
      "name": "evidence_assessments",
      "schema_ref": "evidence_assessment.schema.json",
      "required": false,
      "cardinality": "zero_or_more",
      "source": "evidence_validator",
      "description": null
    },
    {
      "name": "routing_decision",
      "schema_ref": "internal:routing_decision",
      "required": true,
      "cardinality": "one",
      "source": "risk_escalation_router",
      "description": null
    },
    {
      "name": "recommendation_thresholds",
      "schema_ref": "config:recommendation_thresholds.json",
      "required": true,
      "cardinality": "one",
      "source": "profile_loader",
      "description": null
    }
  ],
  "outputs": [
    {
      "name": "recommendation",
      "schema_ref": "recommendation.schema.json",
      "cardinality": "one",
      "consumer": "packet_assembler",
      "description": null
    }
  ],
  "configuration_dependencies": [
    "recommendation thresholds",
    "organization opportunity-factor weights",
    "reviewer-role map"
  ],
  "fixed_dependencies": [
    "recommendation completeness schema",
    "counterevidence requirement",
    "missing-information requirement",
    "nonbinding disclosure",
    "abstention and escalation rules"
  ],
  "preconditions": [
    "Routing decision is available.",
    "All supplied component outputs are schema-valid.",
    "Audit writing is available."
  ],
  "postconditions": [
    "Recommendation validates against recommendation.schema.json.",
    "Every material supporting and opposing fact is disclosed.",
    "Insufficient evidence produces No Recommendation or Escalate.",
    "The required human reviewer and next action are explicit."
  ],
  "allowed_side_effects": [
    "Write recommendation_created or recommendation_abstained audit event."
  ],
  "prohibited_side_effects": [
    "Make a final bid/no-bid decision.",
    "Authorize price, staffing, legal, security, or contractual commitments.",
    "Omit counterevidence or missing information.",
    "Use unsupported free-form claims as evidence.",
    "Perform an external action."
  ],
  "failure_modes": [
    {
      "error_code": "RECOMMENDATION_INPUT_INCOMPLETE",
      "condition": "Required evidence, routing, or configuration input is missing.",
      "behavior": "abstain",
      "audit_status": "warned",
      "human_route": "Opportunity Analyst"
    },
    {
      "error_code": "RECOMMENDATION_SCHEMA_INVALID",
      "condition": "The assembled recommendation fails schema completeness.",
      "behavior": "fail_closed",
      "audit_status": "failed",
      "human_route": "Technical Reviewer"
    },
    {
      "error_code": "RECOMMENDATION_EVIDENCE_INSUFFICIENT",
      "condition": "Evidence does not support a directional recommendation.",
      "behavior": "abstain",
      "audit_status": "warned",
      "human_route": "Business Development or Pursuit Lead"
    }
  ],
  "audit_events": [
    "recommendation_created",
    "recommendation_abstained",
    "processing_failed"
  ],
  "downstream_consumers": [
    "packet_assembler",
    "human_disposition_recorder",
    "evaluation_pipeline"
  ],
  "idempotency": {
    "idempotent": true,
    "key": "case_state_hash + thresholds_version + safeguard_version",
    "replay_behavior": "append_new_version"
  },
  "retry_policy": {
    "permitted": false,
    "maximum_attempts": 0,
    "retryable_conditions": []
  },
  "human_checkpoint": {
    "required": true,
    "role": "Configured authorized reviewer",
    "response_options": [
      "accept",
      "accept_with_modified_conditions",
      "reject",
      "defer_pending_information",
      "escalate"
    ]
  },
  "production_boundary": "Controlled capstone prototype; no autonomous external action; nonbinding recommendation only; final human authority required."
}