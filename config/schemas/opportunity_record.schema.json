{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://icmsol.example/project7/schemas/opportunity_record.schema.json",
  "title": "Normalized Opportunity Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_schema_version",
    "opportunity_id",
    "case_id",
    "source",
    "source_portal",
    "jurisdiction",
    "agency",
    "solicitation_id",
    "title",
    "normalized_title",
    "status",
    "ingested_at",
    "record_key",
    "original_values",
    "missing_fields"
  ],
  "properties": {
    "record_schema_version": {
      "$ref": "common_definitions.schema.json#/$defs/semantic_version"
    },
    "opportunity_id": {
      "$ref": "common_definitions.schema.json#/$defs/identifier"
    },
    "case_id": {
      "$ref": "common_definitions.schema.json#/$defs/identifier"
    },
    "source": {
      "$ref": "common_definitions.schema.json#/$defs/source_reference"
    },
    "source_portal": {
      "type": "string",
      "minLength": 1
    },
    "jurisdiction": {
      "type": "string",
      "minLength": 1
    },
    "agency": {
      "type": "string",
      "minLength": 1
    },
    "solicitation_id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "normalized_title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "closed",
        "cancelled",
        "awarded",
        "planned",
        "unknown"
      ]
    },
    "posted_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "due_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "fiscal_year": {
      "type": [
        "string",
        "null"
      ]
    },
    "fiscal_quarter": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "Q1",
        "Q2",
        "Q3",
        "Q4",
        null
      ]
    },
    "place_of_performance": {
      "type": [
        "string",
        "null"
      ]
    },
    "procurement_method": {
      "type": [
        "string",
        "null"
      ]
    },
    "contract_vehicle": {
      "type": [
        "string",
        "null"
      ]
    },
    "estimated_value": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "amount",
            "currency"
          ],
          "properties": {
            "amount": {
              "type": "number",
              "minimum": 0
            },
            "currency": {
              "type": "string",
              "pattern": "^[A-Z]{3}$"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "ingested_at": {
      "$ref": "common_definitions.schema.json#/$defs/utc_datetime"
    },
    "normalization_version": {
      "$ref": "common_definitions.schema.json#/$defs/semantic_version"
    },
    "record_key": {
      "type": "string",
      "pattern": "^[a-f0-9]{20}$"
    },
    "original_values": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": true
    },
    "missing_fields": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "data_freshness_days": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "limitations": {
      "type": "array",
      "items": {
        "$ref": "common_definitions.schema.json#/$defs/limitation"
      }
    }
  }
}