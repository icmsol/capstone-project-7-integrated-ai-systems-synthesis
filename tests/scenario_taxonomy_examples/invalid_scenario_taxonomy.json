{
  "taxonomy_schema_version": "1.0.0",
  "taxonomy_id": "PROJECT7-P3-02-SCENARIO-TAXONOMY",
  "purpose": "Define a balanced, risk-based scenario taxonomy and target-case inventory for the integrated workload. The taxonomy freezes intended behavior, routing, evidence classes, reason codes, safeguards, and coverage without yet creating final case-specific inputs or claiming measured results.",
  "design_principles": [
    "Normal and failure behavior receive comparable evaluation attention.",
    "Every target case has an explicit expected terminal outcome.",
    "Every case identifies required and prohibited behavior.",
    "Evidence and counterevidence expectations are defined before execution.",
    "Human authority is evaluated separately from recommendation quality.",
    "Projects 3 and 5 remain bounded evidence rather than hidden runtime contributors.",
    "Profile portability uses the same executable workflow and opportunity.",
    "Prompt injection, privacy, secrets, and external-action misuse are first-class cases.",
    "Audit and retry behavior are tested under simulated failure.",
    "Targets remain unmeasured until frozen inputs and execution evidence exist."
  ],
  "categories": [
    {
      "category_id": "CAT-01",
      "category_name": "Normal Positive Operation",
      "category_type": "normal_operation",
      "objective": "Verify complete supported cases that reach authorized human disposition.",
      "minimum_cases": 2,
      "primary_risks": [
        "false negative",
        "incomplete packet",
        "missing human authority"
      ]
    },
    {
      "category_id": "CAT-02",
      "category_name": "Ambiguity and Sparse Data",
      "category_type": "data_quality",
      "objective": "Verify explicit uncertainty, abstention, and requests for missing information.",
      "minimum_cases": 2,
      "primary_risks": [
        "false certainty",
        "silent inference",
        "unsupported fit"
      ]
    },
    {
      "category_id": "CAT-03",
      "category_name": "Model Confidence and Domain Limits",
      "category_type": "model_behavior",
      "objective": "Verify confidence, domain, truncation, and package-integrity controls.",
      "minimum_cases": 3,
      "primary_risks": [
        "high-confidence error",
        "domain shift",
        "hidden truncation"
      ]
    },
    {
      "category_id": "CAT-04",
      "category_name": "Evidence Retrieval and Citation Integrity",
      "category_type": "evidence_behavior",
      "objective": "Verify exact citation precedence, corpus approval, freshness, and safe missing-authority handling.",
      "minimum_cases": 3,
      "primary_risks": [
        "wrong citation",
        "stale source",
        "unapproved corpus"
      ]
    },
    {
      "category_id": "CAT-05",
      "category_name": "Evidence Sufficiency and Conflict",
      "category_type": "evidence_behavior",
      "objective": "Verify abstention for weak evidence and escalation for material conflict.",
      "minimum_cases": 2,
      "primary_risks": [
        "unsupported recommendation",
        "counterevidence omission"
      ]
    },
    {
      "category_id": "CAT-06",
      "category_name": "Prompt Injection and Misuse",
      "category_type": "security_privacy",
      "objective": "Verify that untrusted instructions cannot alter tools, policy, sources, or authority.",
      "minimum_cases": 2,
      "primary_risks": [
        "instruction override",
        "external action",
        "secret disclosure"
      ]
    },
    {
      "category_id": "CAT-07",
      "category_name": "Sensitive Data and Secret Handling",
      "category_type": "security_privacy",
      "objective": "Verify redaction, blocking, escalation, and repository-safe audit behavior.",
      "minimum_cases": 2,
      "primary_risks": [
        "privacy exposure",
        "credential leakage"
      ]
    },
    {
      "category_id": "CAT-08",
      "category_name": "Configuration and Portability",
      "category_type": "portability",
      "objective": "Verify profile portability and rejection of safeguard overrides.",
      "minimum_cases": 2,
      "primary_risks": [
        "hard-coded logic",
        "configuration drift",
        "safeguard weakening"
      ]
    },
    {
      "category_id": "CAT-09",
      "category_name": "Human Authority and Reviewer Authorization",
      "category_type": "human_authority",
      "objective": "Verify authorized rationale and mandatory specialist routing.",
      "minimum_cases": 2,
      "primary_risks": [
        "autonomous decision",
        "unauthorized reviewer"
      ]
    },
    {
      "category_id": "CAT-10",
      "category_name": "Audit and Recovery Resilience",
      "category_type": "resilience",
      "objective": "Verify fail-closed persistence, bounded retries, and reproducible failure reporting.",
      "minimum_cases": 2,
      "primary_risks": [
        "untraceable output",
        "unbounded retry"
      ]
    },
    {
      "category_id": "CAT-11",
      "category_name": "External Action and Production Boundary",
      "category_type": "governance",
      "objective": "Verify prohibition of external commitments and unsupported production-readiness claims.",
      "minimum_cases": 2,
      "primary_risks": [
        "unauthorized commitment",
        "production misuse"
      ]
    }
  ],
