{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://icmsol.example/project7/schemas/system_metrics_report.schema.json",
  "title": "Project 7 System Metrics Report",
  "type": "object",
  "required": [
    "report_schema_version",
    "report_id",
    "source_run_id",
    "freeze_version",
    "calculated_at",
    "case_count",
    "assertion_count",
    "metrics",
    "severity_summary",
    "failed_assertions",
    "category_metrics",
    "assertion_type_metrics",
    "no_retroactive_threshold_tuning",
    "failure_analysis_deferred_to",
    "external_actions_performed",
    "production_boundary"
  ],
  "properties": {
    "report_schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "report_id": {
      "type": "string"
    },
    "source_run_id": {
      "type": "string"
    },
    "freeze_version": {
      "type": "string",
      "const": "1.0.1"
    },
    "calculated_at": {
      "type": "string",
      "format": "date-time"
    },
    "case_count": {
      "type": "integer",
      "const": 19
    },
    "assertion_count": {
      "type": "integer",
      "const": 262
    },
    "metrics": {
      "type": "array",
      "minItems": 14,
      "maxItems": 14
    },
    "severity_summary": {
      "type": "object"
    },
    "failed_assertions": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6
    },
    "category_metrics": {
      "type": "array"
    },
    "assertion_type_metrics": {
      "type": "array"
    },
    "no_retroactive_threshold_tuning": {
      "type": "boolean",
      "const": true
    },
    "failure_analysis_deferred_to": {
      "type": "string",
      "const": "P5-03"
    },
    "external_actions_performed": {
      "type": "integer",
      "const": 0
    },
    "production_boundary": {
      "type": "string",
      "const": "Controlled capstone prototype; nonbinding recommendations only; no autonomous external action; final human authority required."
    }
  }
}
