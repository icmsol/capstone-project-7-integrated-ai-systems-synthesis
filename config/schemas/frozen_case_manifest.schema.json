{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://icmsol.example/project7/schemas/frozen_case_manifest.schema.json",
  "title": "Project 7 Frozen Scenario Case Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_schema_version",
    "case_id",
    "case_name",
    "freeze_version",
    "freeze_timestamp_utc",
    "reference_profile",
    "execution_mode",
    "deterministic_seed",
    "taxonomy_source",
    "required_files",
    "expected_terminal_outcome",
    "expected_primary_stage",
    "expected_component",
    "expected_reason_codes",
    "checksum_status",
    "result_status"
  ],
  "properties": {
    "manifest_schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "case_id": {
      "type": "string",
      "pattern": "^TC-\\d{2}$"
    },
    "case_name": {
      "type": "string",
      "minLength": 8
    },
    "freeze_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "freeze_timestamp_utc": {
      "type": "string",
      "format": "date-time"
    },
    "reference_profile": {
      "type": "string",
      "enum": [
        "icm",
        "fictional_alternate",
        "both"
      ]
    },
    "execution_mode": {
      "type": "string",
      "enum": [
        "real_components_with_frozen_inputs",
        "real_components_with_controlled_model_fixture",
        "controlled_fault_injection",
        "profile_comparison"
      ]
    },
    "deterministic_seed": {
      "type": "integer",
      "const": 42
    },
    "taxonomy_source": {
      "type": "string",
      "const": "config/system/scenario_taxonomy_and_target_cases.json"
    },
    "required_files": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256",
          "bytes",
          "role"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 3
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 1
          },
          "role": {
            "type": "string",
            "minLength": 5
          }
        }
      }
    },
    "expected_terminal_outcome": {
      "type": "string",
      "enum": [
        "finalized_accept",
        "finalized_accept_with_conditions",
        "finalized_reject",
        "deferred",
        "escalated",
        "failed_closed",
        "no_recommendation"
      ]
    },
    "expected_primary_stage": {
      "type": "string",
      "pattern": "^STG-\\d{2}$"
    },
    "expected_component": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{2,63}$"
    },
    "expected_reason_codes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_:-]{2,63}$"
      }
    },
    "checksum_status": {
      "type": "string",
      "const": "verified_at_freeze"
    },
    "result_status": {
      "type": "string",
      "const": "not_executed_target_only"
    }
  }
}
