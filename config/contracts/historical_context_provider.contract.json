{
  "contract_schema_version": "1.0.0",
  "contract_id": "CONTRACT-HISTORICAL_CONTEXT",
  "component_id": "historical_context_provider",
  "component_name": "Frozen Historical Procurement Context Provider",
  "component_type": "historical_context_provider",
  "purpose": "Attach descriptive historical service-category and staffing-family context from frozen, checksum-verified prior-project assets.",
  "implementation_boundary": "framework_controlled",
  "inputs": [
    {
      "name": "opportunity",
      "schema_ref": "opportunity_record.schema.json",
      "required": true,
      "cardinality": "one",
      "source": "case_intake_normalizer",
      "description": null
    },
    {
      "name": "service_alignment",
      "schema_ref": "service_alignment.schema.json",
      "required": true,
      "cardinality": "one",
      "source": "service_alignment_engine",
      "description": null
    },
    {
      "name": "historical_assets",
      "schema_ref": "project2:frozen_processed_assets",
      "required": true,
      "cardinality": "one",
      "source": "approved_prior_project_registry",
      "description": null
    }
  ],
  "outputs": [
    {
      "name": "historical_context",
      "schema_ref": "historical_context.schema.json",
      "cardinality": "one",
      "consumer": "recommendation_engine",
      "description": null
    }
  ],
  "configuration_dependencies": [
    "organization staffing-family map"
  ],
  "fixed_dependencies": [
    "approved prior-project asset registry",
    "historical_context.schema.json",
    "descriptive-only limitation"
  ],
  "preconditions": [
    "Historical asset checksums are known.",
    "The source period is frozen and explicit."
  ],
  "postconditions": [
    "Counts and source period are recorded.",
    "The interpretation states that context is descriptive and non-predictive."
  ],
  "allowed_side_effects": [
    "Write historical_context_attached audit event."
  ],
  "prohibited_side_effects": [
    "Forecast award likelihood.",
    "Estimate current staffing capacity.",
    "Represent frozen historical counts as current demand."
  ],
  "failure_modes": [
    {
      "error_code": "HISTORICAL_ASSET_MISSING",
      "condition": "Required frozen asset is absent or its checksum differs.",
      "behavior": "warn_and_continue",
      "audit_status": "warned",
      "human_route": "Data Reviewer"
    },
    {
      "error_code": "HISTORICAL_CONTEXT_NOT_COMPARABLE",
      "condition": "The current opportunity cannot be meaningfully mapped to the historical categories.",
      "behavior": "abstain",
      "audit_status": "warned",
      "human_route": "Opportunity Analyst"
    }
  ],
  "audit_events": [
    "historical_context_attached",
    "processing_failed"
  ],
  "downstream_consumers": [
    "recommendation_engine",
    "packet_assembler"
  ],
  "idempotency": {
    "idempotent": true,
    "key": "record_key + historical_asset_checksums + staffing_map_version",
    "replay_behavior": "recompute_and_compare"
  },
  "retry_policy": {
    "permitted": false,
    "maximum_attempts": 0,
    "retryable_conditions": []
  },
  "human_checkpoint": {
    "required": false,
    "role": null,
    "response_options": []
  },
  "production_boundary": "Controlled capstone prototype; no autonomous external action; nonbinding recommendation only; final human authority required."
}